# PKG_VER here is the PHP7.4 package version expected to be INSTALLED ON THE
# NAS (install.sh checks it against /var/packages/PHP7.4/INFO). 7.4.30-0118
# was the last i686 build Synology ever shipped on Package Center, so it is
# the most likely value for a DS214play kept up to date -- but CONFIRM over
# SSH before installing (`cat /var/packages/PHP7.4/INFO | grep -E 'version|arch'`
# and `uname -m`) and edit this file if your NAS has a different version.
# This is independent from build/targets/evansport-dsm71.env's PKG_VER, which
# is only a local build-time reference (see the comment there for why).
PKG_ARCH=i686
PKG_VER=7.4.30-0118
REF_PHP_VER=7.4.30
NEW_PHP_VER=7.4.33
