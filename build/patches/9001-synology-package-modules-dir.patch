+
+	if (pkg_path) {
+		php_load_extension(pkg_path, MODULE_PERSISTENT, 0);
+		efree(pkg_path);
+	} else {
+		php_load_extension(*((char **) arg), MODULE_PERSISTENT, 0);
+	}
 #endif
 }
