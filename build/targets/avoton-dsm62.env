# Default target: Synology DSM 6.2, "avoton" platform (x86_64).
# Encodes exactly today's hardcoded values; selected automatically when
# SYNO_TARGET is unset.
: "${PLATFORM:=avoton}"
: "${DSM_VER:=6.2}"
: "${HOST:=x86_64-pc-linux-gnu}"
: "${BUILD:=$HOST}"          # host == build on purpose, see build-php74-dsm62.sh
: "${PKG_ARCH:=x86_64}"
: "${PKG_VER:=7.4.30-0009}"
: "${REF_PHP_VER:=7.4.30}"
: "${NEW_PHP_VER:=7.4.33}"
: "${PCRE2_VER:=10.40}"
: "${ONIG_VER:=6.9.5}"
: "${LIBXML2_VER:=2.9.4}"
: "${FREETDS_FROM_SOURCE:=0}"   # copy the reference package's own libsybdb.so (unchanged behavior)
: "${W:=$HOME/synobuild}"
